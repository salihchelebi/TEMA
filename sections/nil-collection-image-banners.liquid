-width:none!important}.nil-collection-image-banners .ncb-link{display:block!important;width:100%!important;overflow:hidden!important;text-decoration:none!important;border:1px solid rgba(184,138,68,.42)!important;background:#fff8ee!important;box-shadow:0 16px 42px rgba(72,42,14,.06)!important}.nil-collection-image-banners .ncb-whatsapp .ncb-link{height:var(--ncb-wa-h,56px)!important;min-height:var(--ncb-wa-h,56px)!important}.nil-collection-image-banners .ncb-collection .ncb-link{height:var(--ncb-c-h,320px)!important;min-height:var(--ncb-c-h,320px)!important;border-radius:var(--ncb-radius,18px)!important}.nil-collection-image-banners img{display:block!important;width:100%!important;height:100%!important;max-width:none!important;object-position:center!important}.nil-collection-image-banners .ncb-whatsapp img{object-fit:var(--ncb-fit-wa,cover)!important}.nil-collection-image-banners .ncb-collection img{object-fit:var(--ncb-fit-c,cover)!important}.nil-collection-image-banners .ncb-placeholder{display:grid!important;place-items:center!important;width:100%!important;height:100%!important;color:#9a6b32!important;background:repeating-linear-gradient(135deg,#fffaf2 0,#fffaf2 12px,#fff4e6 12px,#fff4e6 24px)!important;border:1px dashed rgba(184,138,68,.45)!important;font:900 12px/1.2 system-ui,sans-serif!important;letter-spacing:.14em!important;text-transform:uppercase!important;text-align:center!important}.nil-collection-image-banners .ncb-placeholder-large{font-size:14px!important;padding:24px!important}@media(max-width:989px){.nil-collection-image-banners{padding-left:10px!important;padding-right:10px!important}.nil-collection-image-banners .ncb-whatsapp .ncb-link{height:var(--ncb-wa-hm,48px)!important;min-height:var(--ncb-wa-hm,48px)!important}.nil-collection-image-banners .ncb-collection .ncb-link{height:var(--ncb-c-hm,210px)!important;min-height:var(--ncb-c-hm,210px)!important;border-radius:14px!important}.nil-collection-image-banners .ncb-placeholder{font-size:10px!impor