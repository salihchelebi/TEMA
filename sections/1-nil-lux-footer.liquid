</style>

{% schema %}
{
  "name": "NIL Luxury Footer",
  "tag": "section",
  "class": "nil-lux-footer-section",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "NIL Wedding Dress"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 100,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 170
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "NIL"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand subtitle",
      "default": "Wedding Dress"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Timeless elegance, modern craftsmanship. Discover your dream dress, made just for you."
    },
    {
      "type": "header",
      "content": "Social & contact"
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number, digits only",
      "default": "905334619373"
    },
    {
      "type": "text",
      "id": "whatsapp_display",
      "label": "WhatsApp display text",
      "default": "+90 533 461 93 73"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp prefilled message",
      "default": "Hello, I need help choosing a NIL Wedding Dress."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@nilweddingdress.com"
    },
    {
      "type": "checkbox",
      "id": "show_contact_column",
      "label": "Show customer care column",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Customer Care"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "NIL Wedding Dress Showroom\nIstanbul, Türkiye"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Working hours",
      "default": "Mon - Sat / 10:00 - 19:00\nGMT+3"
    },
    {
      "type": "header",
      "content": "WhatsApp consultation"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp_box",
      "label": "Show WhatsApp consultation",
      "default": true
    },
    {
      "type": "text",
      "id": "wa_heading",
      "label": "WhatsApp heading",
      "default": "WhatsApp Consultation"
    },
    {
      "type": "textarea",
      "id": "wa_text",
      "label": "WhatsApp text",
      "default": "Get instant help from our bridal consultants for sizing, fabric selection, customization and delivery questions."
    },
    {
      "type": "text",
      "id": "wa_button_label",
      "label": "WhatsApp button label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join Our Bridal List"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Be the first to know about new arrivals, private offers and bridal styling inspiration."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Newsletter success message",
      "default": "Thank you for joining our bridal list."
    },
    {
      "type": "header",
      "content": "Trust bars"
    },
    {
      "type": "checkbox",
      "id": "show_top_trust_bar",
      "label": "Show top trust bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_middle_trust_bar",
      "label": "Show lower trust bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_badges",
      "label": "Show payment badges",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All Rights Reserved."
    },
    {
      "type": "header",
      "content": "Instagram strip"
    },
    {
      "type": "checkbox",
      "id": "show_instagram_strip",
      "label": "Show Instagram strip",
      "default": true
    },
    {
      "type": "text",
      "id": "instagram_heading",
      "label": "Instagram heading",
      "default": "Follow @nilweddingdress"
    },
    {
      "type": "text",
      "id": "instagram_text",
      "label": "Instagram text",
      "default": "Tag us to be featured"
    },
    {
      "type": "text",
      "id": "instagram_button",
      "label": "Instagram button",
      "default": "View More on Instagram"
    },
    {
      "type": "header",
      "content": "Layout & colors"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 1200,
      "max": 1800,
      "step": 24,
      "unit": "px",
      "default": 1536
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Theme color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "soft_bg_color",
      "label": "Soft background color",
      "default": "#f7efe4"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#fbf3e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1d1712"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#50483f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent color",
      "default": "#bd8233"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e7d6c1"
    }
  ],
  "blocks": [
    {
      "type": "trust_item_top",
      "name": "Top trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "dress",
              "label": "Dress"
            },
            {
              "value": "secure",
              "label": "Secure"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Worldwide Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Fast & secure delivery"
        }
      ]
    },
    {
      "type": "menu_column",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Shopify menu"
        },
        {
          "type": "header",
          "content": "Manual links if no menu selected"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 label",
          "default": "All Dresses"
        },
        {
          "type": "url",
