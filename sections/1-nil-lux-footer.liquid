      gap: 36px !important;
      padding-top: 44px !important;
      padding-bottom: 38px !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__menus {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__instagram-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__instagram-more {
      min-height: 88px !important;
