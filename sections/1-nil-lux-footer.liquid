{% comment %}
  File: sections/1-nil-lux-footer.liquid
  NIL / NISAI premium footer section.
  This section is intentionally self-contained. The layout CSS is scoped to
  #NilLuxFooter-{{ section.id }} so theme CSS cannot collapse it into a vertical list.
{% endcomment %}

<div
  id="NilLuxFooter-{{ section.id }}"
  class="nil-lux-footer color-{{ section.settings.color_scheme }}"
  style="
    --nil-footer-bg: {{ section.settings.bg_color }};
    --nil-footer-soft-bg: {{ section.settings.soft_bg_color }};
    --nil-footer-card-bg: {{ section.settings.card_bg_color }};
    --nil-footer-text: {{ section.settings.text_color }};
    --nil-footer-muted: {{ section.settings.muted_text_color }};
    --nil-footer-gold: {{ section.settings.accent_color }};
    --nil-footer-border: {{ section.settings.border_color }};
    --nil-footer-max-width: {{ section.settings.max_width }}px;
  "
>
  {% if section.settings.show_top_trust_bar %}
    <div class="nil-lux-footer__top-trust">
      <div class="nil-lux-footer__top-trust-inner">
        {% for block in section.blocks %}
          {% if block.type == 'trust_item_top' %}
            <div class="nil-lux-footer__trust-item" {{ block.shopify_attributes }}>
              <span class="nil-lux-footer__icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'shipping' %}
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M4 9h16v12H4zM20 13h5l3 4v4h-8zM9 25a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM24 25a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/></svg>
                  {% when 'dress' %}
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M16 4l4 6-3 4 7 14H8l7-14-3-4 4-6zM12 10h8"/></svg>
                  {% when 'secure' %}
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M16 4l10 4v7c0 7-4.5 11-10 13-5.5-2-10-6-10-13V8l10-4zM12 16l3 3 6-7"/></svg>
                  {% when 'whatsapp' %}
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M16 5a11 11 0 0 0-9.5 16.5L5 27l5.7-1.5A11 11 0 1 0 16 5z"/><path d="M12 12c1.5 4 4 6.5 8 8l2-2-3-2-1 1c-1.8-.8-3.2-2.2-4-4l1-1-2-3-2 3z"/></svg>
                  {% else %}
                    <svg viewBox="0 0 32 32" focusable="false"><path d="M16 4l3.5 8.5L28 16l-8.5 3.5L16 28l-3.5-8.5L4 16l8.5-3.5L16 4z"/></svg>
                {% endcase %}
              </span>
              <span class="nil-lux-footer__trust-copy">
                <strong>{{ block.settings.heading }}</strong>
                <small>{{ block.settings.text }}</small>
              </span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="nil-lux-footer__main">
    <div class="nil-lux-footer__brand">
      {% if section.settings.logo != blank %}
        <img
          class="nil-lux-footer__logo-img"
          src="{{ section.settings.logo | image_url: width: 520 }}"
          alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
          width="{{ section.settings.logo_width }}"
          loading="lazy"
        >
      {% else %}
        <div class="nil-lux-footer__logo-text" aria-label="{{ section.settings.logo_alt | default: shop.name | escape }}">
          <span>{{ section.settings.brand_name | default: 'NIL' }}</span>
          <small>{{ section.settings.brand_subtitle | default: 'Wedding Dress' }}</small>
        </div>
      {% endif %}

      {% if section.settings.brand_description != blank %}
        <p class="nil-lux-footer__brand-desc">{{ section.settings.brand_description }}</p>
      {% endif %}

      {% if section.settings.show_socials %}
        <div class="nil-lux-footer__social-wrap">
          <h3>Follow Us</h3>
          <div class="nil-lux-footer__socials" aria-label="Social links">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg viewBox="0 0 32 32" focusable="false"><rect x="7" y="7" width="18" height="18" rx="5"/><circle cx="16" cy="16" r="4"/><path d="M22 10.5h.1"/></svg>
              </a>
            {% endif %}
            {% if section.settings.whatsapp_number != blank %}
              <a href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                <svg viewBox="0 0 32 32" focusable="false"><path d="M16 5a11 11 0 0 0-9.5 16.5L5 27l5.7-1.5A11 11 0 1 0 16 5z"/><path d="M12 12c1.5 4 4 6.5 8 8l2-2-3-2-1 1c-1.8-.8-3.2-2.2-4-4l1-1-2-3-2 3z"/></svg>
              </a>
            {% endif %}
            {% if section.settings.pinterest_url != blank %}
              <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                <svg viewBox="0 0 32 32" focusable="false"><path d="M16 5a10 10 0 0 0-3 19c.5-2 1-4 1.5-6M16 16c3 1 5-1 5-4 0-3-2-5-5-5s-5 2-5 5c0 2 1 3 2 4"/></svg>
              </a>
            {% endif %}
            {% if section.settings.email != blank %}
              <a href="mailto:{{ section.settings.email }}" aria-label="Email">
                <svg viewBox="0 0 32 32" focusable="false"><path d="M5 9h22v14H5z"/><path d="M5 10l11 8 11-8"/></svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="nil-lux-footer__menus">
      {% for block in section.blocks %}
        {% if block.type == 'menu_column' %}
          <nav class="nil-lux-footer__menu-col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}
            <ul>
              {% if block.settings.menu != blank %}
                {% assign selected_menu = linklists[block.settings.menu] %}
                {% for link in selected_menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              {% else %}
                {% if block.settings.link_1_label != blank %}<li><a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_label }}</a></li>{% endif %}
                {% if block.settings.link_2_label != blank %}<li><a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_label }}</a></li>{% endif %}
                {% if block.settings.link_3_label != blank %}<li><a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_label }}</a></li>{% endif %}
                {% if block.settings.link_4_label != blank %}<li><a href="{{ block.settings.link_4_url | default: '#' }}">{{ block.settings.link_4_label }}</a></li>{% endif %}
                {% if block.settings.link_5_label != blank %}<li><a href="{{ block.settings.link_5_url | default: '#' }}">{{ block.settings.link_5_label }}</a></li>{% endif %}
                {% if block.settings.link_6_label != blank %}<li><a href="{{ block.settings.link_6_url | default: '#' }}">{{ block.settings.link_6_label }}</a></li>{% endif %}
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_contact_column %}
      <div class="nil-lux-footer__contact">
        <h3>{{ section.settings.contact_heading | default: 'Customer Care' }}</h3>

        {% if section.settings.address != blank %}
          <p>
            <span aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><path d="M16 28s8-8 8-15a8 8 0 0 0-16 0c0 7 8 15 8 15z"/><circle cx="16" cy="13" r="3"/></svg></span>
            <span>{{ section.settings.address | newline_to_br }}</span>
          </p>
        {% endif %}

        {% if section.settings.whatsapp_number != blank %}
          <p>
            <span aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><path d="M16 5a11 11 0 0 0-9.5 16.5L5 27l5.7-1.5A11 11 0 1 0 16 5z"/><path d="M12 12c1.5 4 4 6.5 8 8l2-2-3-2-1 1c-1.8-.8-3.2-2.2-4-4l1-1-2-3-2 3z"/></svg></span>
            <span><a href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener noreferrer">{{ section.settings.whatsapp_display }}</a><br><small>(WhatsApp)</small></span>
          </p>
        {% endif %}

        {% if section.settings.email != blank %}
          <p>
            <span aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><path d="M5 9h22v14H5z"/><path d="M5 10l11 8 11-8"/></svg></span>
            <span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></span>
          </p>
        {% endif %}

        {% if section.settings.hours != blank %}
          <p>
            <span aria-hidden="true"><svg viewBox="0 0 32 32" focusable="false"><circle cx="16" cy="16" r="11"/><path d="M16 9v8l5 3"/></svg></span>
            <span>{{ section.settings.hours | newline_to_br }}</span>
          </p>
        {% endif %}
      </div>
    {% endif %}

    <aside class="nil-lux-footer__action-card" aria-label="WhatsApp consultation and newsletter">
      {% if section.settings.show_whatsapp_box %}
        <div class="nil-lux-footer__wa-box">
          <h3>{{ section.settings.wa_heading | default: 'WhatsApp Consultation' }}</h3>
          <p>{{ section.settings.wa_text }}</p>
          {% if section.settings.whatsapp_number != blank %}
            <a class="nil-lux-footer__wa-btn" href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 32 32" focusable="false" aria-hidden="true"><path d="M16 5a11 11 0 0 0-9.5 16.5L5 27l5.7-1.5A11 11 0 1 0 16 5z"/><path d="M12 12c1.5 4 4 6.5 8 8l2-2-3-2-1 1c-1.8-.8-3.2-2.2-4-4l1-1-2-3-2 3z"/></svg>
              <span>{{ section.settings.wa_button_label | default: 'Chat on WhatsApp' }}</span>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_newsletter %}
        <div class="nil-lux-footer__newsletter">
          <h3>{{ section.settings.newsletter_heading | default: 'Join Our Bridal List' }}</h3>
          <p>{{ section.settings.newsletter_text }}</p>

          {% form 'customer', id: 'NilLuxuryFooterNewsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter,footer,nil-bridal-list">
            <div class="nil-lux-footer__newsletter-row">
              <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                aria-label="{{ section.settings.newsletter_placeholder }}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button type="submit">{{ section.settings.newsletter_button | default: 'Subscribe' }}</button>
            </div>
            {% if form.posted_successfully? %}
              <p class="nil-lux-footer__form-msg">{{ section.settings.newsletter_success }}</p>
            {% endif %}
            {% if form.errors %}
              <div class="nil-lux-footer__form-msg">{{ form.errors | default_errors }}</div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </aside>
  </div>

  {% if section.settings.show_middle_trust_bar %}
    <div class="nil-lux-footer__bottom-trust">
      {% for block in section.blocks %}
        {% if block.type == 'trust_item_bottom' %}
          <div class="nil-lux-footer__mini-trust" {{ block.shopify_attributes }}>
            <span class="nil-lux-footer__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'alterations' %}
                  <svg viewBox="0 0 32 32" focusable="false"><path d="M10 7c4 4 8 4 12 0M8 25c5-3 11-3 16 0M10 7l-4 18M22 7l4 18"/></svg>
                {% when 'gift' %}
                  <svg viewBox="0 0 32 32" focusable="false"><path d="M5 13h22v14H5zM5 13h22M16 13v14M8 9c0-2 2-4 4-2l4 6M24 9c0-2-2-4-4-2l-4 6"/></svg>
                {% when 'appointment' %}
                  <svg viewBox="0 0 32 32" focusable="false"><path d="M7 8h18v18H7zM11 5v6M21 5v6M7 13h18M12 18h8"/></svg>
                {% when 'dream' %}
                  <svg viewBox="0 0 32 32" focusable="false"><path d="M16 4l4 6-3 4 7 14H8l7-14-3-4 4-6zM12 10h8"/></svg>
                {% else %}
                  <svg viewBox="0 0 32 32" focusable="false"><path d="M16 4l3.5 8.5L28 16l-8.5 3.5L16 28l-3.5-8.5L4 16l8.5-3.5L16 4z"/></svg>
              {% endcase %}
            </span>
            <span class="nil-lux-footer__trust-copy">
              <strong>{{ block.settings.heading }}</strong>
              <small>{{ block.settings.text }}</small>
            </span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <div class="nil-lux-footer__legal">
    <div class="nil-lux-footer__copyright">
      © {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. {{ section.settings.copyright_text | default: 'All Rights Reserved.' }}
    </div>

    {% if section.settings.show_policy_links %}
      <div class="nil-lux-footer__policies">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <span>·</span>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <span>·</span>
        <a href="/policies/refund-policy">Refund Policy</a>
        <span>·</span>
        <a href="/policies/shipping-policy">Shipping Policy</a>
      </div>
    {% endif %}

    {% if section.settings.show_payment_badges %}
      <div class="nil-lux-footer__payments" aria-label="Payment methods">
        <span>VISA</span>
        <span>MASTERCARD</span>
        <span>IYZCO</span>
        <span>WESTERN UNION</span>
        <span>MONEY GRAM</span>
      </div>
    {% endif %}
  </div>

  {% if section.settings.show_instagram_strip %}
    <div class="nil-lux-footer__instagram">
      <div class="nil-lux-footer__instagram-copy">
        <strong>{{ section.settings.instagram_heading | default: 'Follow @nilweddingdress' }}</strong>
        <span>{{ section.settings.instagram_text | default: 'Tag us to be featured' }}</span>
      </div>

      <div class="nil-lux-footer__instagram-grid">
        {% assign instagram_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'instagram_image' %}
            {% assign instagram_index = instagram_index | plus: 1 %}
            <a href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener noreferrer" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 480 }}"
                  alt="{{ block.settings.alt | default: 'NIL Wedding Dress Instagram image' | escape }}"
                  width="480"
                  height="480"
                  loading="lazy"
                >
              {% else %}
                <span class="nil-lux-footer__insta-placeholder nil-lux-footer__insta-placeholder--{{ instagram_index }}" aria-hidden="true"></span>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>

      <a class="nil-lux-footer__instagram-more" href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener noreferrer">
        <span>{{ section.settings.instagram_button | default: 'View More on Instagram' }}</span>
        <b aria-hidden="true">→</b>
      </a>
    </div>
  {% endif %}
</div>

<style>
  #NilLuxFooter-{{ section.id }} {
    --nil-footer-bg: {{ section.settings.bg_color }};
    --nil-footer-soft-bg: {{ section.settings.soft_bg_color }};
    --nil-footer-card-bg: {{ section.settings.card_bg_color }};
    --nil-footer-text: {{ section.settings.text_color }};
    --nil-footer-muted: {{ section.settings.muted_text_color }};
    --nil-footer-gold: {{ section.settings.accent_color }};
    --nil-footer-border: {{ section.settings.border_color }};
    --nil-footer-max-width: {{ section.settings.max_width }}px;
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: var(--nil-footer-bg) !important;
    color: var(--nil-footer-text) !important;
    border-top: 1px solid var(--nil-footer-border) !important;
  }

  #NilLuxFooter-{{ section.id }},
  #NilLuxFooter-{{ section.id }} *,
  #NilLuxFooter-{{ section.id }} *::before,
  #NilLuxFooter-{{ section.id }} *::after {
    box-sizing: border-box !important;
  }

  #NilLuxFooter-{{ section.id }} a {
    color: inherit !important;
    text-decoration: none !important;
  }

  #NilLuxFooter-{{ section.id }} svg {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.45 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__top-trust {
    width: 100% !important;
    border-bottom: 1px solid var(--nil-footer-border) !important;
    background: linear-gradient(90deg, var(--nil-footer-bg), #fff8ef, var(--nil-footer-bg)) !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__top-trust-inner {
    width: 100% !important;
    max-width: var(--nil-footer-max-width) !important;
    margin: 0 auto !important;
    padding: 36px 56px !important;
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 0 !important;
    align-items: center !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__trust-item,
  #NilLuxFooter-{{ section.id }} .nil-lux-footer__mini-trust {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 20px !important;
    min-width: 0 !important;
    text-align: left !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__trust-item {
    min-height: 52px !important;
    padding: 0 40px !important;
    border-right: 1px solid var(--nil-footer-border) !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__trust-item:last-child,
  #NilLuxFooter-{{ section.id }} .nil-lux-footer__mini-trust:last-child {
    border-right: 0 !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__icon {
    width: 38px !important;
    min-width: 38px !important;
    height: 38px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: var(--nil-footer-gold) !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__trust-copy {
    display: block !important;
    min-width: 0 !important;
  }

  #NilLuxFooter-{{ section.id }} strong,
  #NilLuxFooter-{{ section.id }} h3 {
    display: block !important;
    margin: 0 !important;
    color: #111 !important;
    font-size: 13px !important;
    line-height: 1.25 !important;
    font-weight: 700 !important;
    letter-spacing: .13em !important;
    text-transform: uppercase !important;
  }

  #NilLuxFooter-{{ section.id }} small {
    display: block !important;
    margin: 4px 0 0 !important;
    color: var(--nil-footer-muted) !important;
    font-size: 13px !important;
    line-height: 1.35 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__main {
    width: 100% !important;
    max-width: var(--nil-footer-max-width) !important;
    margin: 0 auto !important;
    padding: 68px 64px 48px !important;
    display: grid !important;
    grid-template-columns: 250px minmax(500px, 1fr) 250px 300px !important;
    gap: 52px !important;
    align-items: start !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__brand {
    max-width: 250px !important;
    display: block !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__logo-img {
    display: block !important;
    width: {{ section.settings.logo_width }}px !important;
    max-width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
    margin: 0 0 24px !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__logo-text span {
    display: block !important;
    margin: 0 !important;
    font-family: Georgia, 'Times New Roman', serif !important;
    font-size: 54px !important;
    line-height: .9 !important;
    letter-spacing: .14em !important;
    font-weight: 400 !important;
    color: var(--nil-footer-gold) !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__logo-text small {
    display: block !important;
    margin-top: 16px !important;
    font-size: 12px !important;
    line-height: 1.2 !important;
    letter-spacing: .45em !important;
    text-transform: uppercase !important;
    color: var(--nil-footer-gold) !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__brand-desc {
    max-width: 245px !important;
    margin: 34px 0 30px !important;
    color: var(--nil-footer-text) !important;
    font-size: 15px !important;
    line-height: 1.75 !important;
    letter-spacing: 0 !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__brand::after {
    content: '' !important;
    display: block !important;
    width: 100% !important;
    height: 1px !important;
    background: var(--nil-footer-border) !important;
    margin: 30px 0 !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__social-wrap h3 {
    margin: 0 0 18px !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__socials {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 18px !important;
    align-items: center !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__socials a {
    width: 24px !important;
    height: 24px !important;
    color: var(--nil-footer-gold) !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__menus {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(135px, 1fr)) !important;
    gap: 52px !important;
    align-items: start !important;
    width: 100% !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__menu-col h3,
  #NilLuxFooter-{{ section.id }} .nil-lux-footer__contact h3,
  #NilLuxFooter-{{ section.id }} .nil-lux-footer__action-card h3 {
    margin: 0 0 26px !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__menu-col ul {
    display: block !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #NilLuxFooter-{{ section.id }} .nil-lux-footer__menu-col li {
    display: block !important;
