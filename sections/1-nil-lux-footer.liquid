    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__trust-item:nth-child(2n) {
      border-right: 0 !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__main {
      grid-template-columns: 1fr 1.45fr !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__action-card,
    #NilLuxFooter-{{ section.id }} .nil-lux-footer__brand,
    #NilLuxFooter-{{ section.id }} .nil-lux-footer__contact {
      max-width: none !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__bottom-trust {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__mini-trust:nth-child(2n) {
      border-right: 0 !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__legal {
      grid-template-columns: 1fr !important;
      text-align: center !important;
    }

    #NilLuxFooter-{{ section.id }} .nil-lux-footer__copyright,
    #NilLuxFooter-{{ section.id }} .nil-lux-footer__payments {
