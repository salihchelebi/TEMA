{% if request.page_type == 'collection' %}
  <div id="nil-direct-collection-mount" class="nil-direct-collection-mount" data-nil-direct-collection="true">
    <style>
      #nil-direct-collection-mount{display:block!important;visibility:visible!important;opacity:1!important;width:100%!important;max-width:1440px!important;margin:0 auto!important;padding:36px 24px 56px!important;background:#fffaf2!important;color:#1f1812!important;position:relative!important;z-index:50!important;clear:both!important;min-height:520px!important;overflow:visible!important}#nil-direct-collection-mount *{box-sizing:border-box!important}.ndc-head{padding:clamp(24px,4vw,46px)!important;margin:0 0 18px!important;background:#fff8ee!important;border:1px solid #ead6ad!important;border-radius:22px!important;box-shadow:0 18px 44px rgba(91,57,18,.08)!important}.ndc-eyebrow{display:block!important;margin:0 0 8px!important;color:#a8732c!important;font-size:12px!important;font-weight:800!important;letter-spacing:.16em!important;text-transform:uppercase!important}#nil-direct-collection-mount h1{margin:0!important;color:#1f1812!important;font-size:clamp(34px,4vw,70px)!important;line-height:.95!important;font-weight:800!important}.ndc-count{display:inline-flex!important;margin-top:16px!important;padding:8px 14px!important;border:1px solid #ead6ad!important;border-radius:999px!important;background:#fff!important;color:#1f1812!important;font-weight:800!important}.ndc-toolbar{display:grid!important;grid-template-columns:auto 1fr auto auto!important;align-items:center!important;gap:10px!important;margin:16px 0!important;padding:12px 14px!important;background:#111!important;color:#fff!important;border:1px solid #d9b878!important;border-radius:18px!important;position:relative!important;z-index:80!important}.ndc-left,.ndc-cols{display:flex!important;flex-wrap:wrap!important;align-items:center!important;gap:8px!important}.ndc-label{font-size:12px!important;font-weight:800!important;letter-spacing:.11em!important;opacity:.75!important}.ndc-pill{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-height:30px!important;padding:7px 10px!important;border:1px solid rgba(255,255,255,.25)!important;border-radius:999px!important;color:#fff!important;text-decoration:none!important;font-size:12px!important;font-weight:700!important;line-height:1!important;background:transparent!important}.ndc-pill.is-active{background:#d9b878!important;color:#1b130b!important;border-color:#d9b878!important}.ndc-search-wrap{position:relative!important;min-width:320px!important;width:100%!important}.ndc-search{display:flex!important;align-items:center!important;gap:10px!important;height:44px!important;padding:0 12px!important;border:1px solid #d9b878!important;border-radius:999px!important;background:#181818!important;color:#fff!important}.ndc-search input{width:100%!important;border:0!important;outline:0!important;background:transparent!important;color:#fff!important;font-size:14px!important;box-shadow:none!important}.ndc-search small{white-space:nowrap!important;color:#d9b878!important;font-size:11px!important;font-weight:700!important}.ndc-x{border:0!important;background:transparent!important;color:#fff!important;font-size:22px!important;line-height:1!important;cursor:pointer!important}.ndc-results{display:none;position:absolute!important;left:50%!important;top:54px!important;transform:translateX(-50%)!important;width:min(620px,92vw)!important;padding:22px!important;background:#fffaf2!important;color:#1f1812!important;border:1px solid #d9b878!important;border-radius:18px!important;box-shadow:0 28px 70px rgba(35,22,8,.28)!important;z-index:999!important}.ndc-results.is-open{display:block!important}.ndc-results:before{content:"";position:absolute;top:-10px;left:50%;width:20px;height:20px;background:#fffaf2;border-left:1px solid #d9b878;border-top:1px solid #d9b878;transform:translateX(-50%) rotate(45deg)}.ndc-results-head{display:flex!important;justify-content:space-between!important;gap:12px!important;margin-bottom:12px!important;font-size:13px!important;font-weight:800!important}.ndc-results-head span{color:#a8732c!important}.ndc-view-all{color:#8c641f!important;text-decoration:underline!important;font-size:13px!important}.ndc-mini-grid{display:grid!important;grid-template-columns:1fr 1fr!important;gap:14px 22px!important}.ndc-mini{display:grid!important;grid-template-columns:92px 1fr!important;gap:12px!important;align-items:center!important;color:#1f1812!important;text-decoration:none!important}.ndc-mini img{width:92px!important;height:92px!important;object-fit:cover!important;border-radius:10px!important;border:1px solid #ead6ad!important}.ndc-mini-title{display:block!important;font-weight:800!important;font-size:13px!important;line-height:1.25!important}.ndc-mini-price{display:block!important;margin-top:5px!important;font-weight:900!important}.ndc-mini-link{display:block!important;margin-top:4px!important;color:#a8732c!important;font-size:12px!important;text-decoration:underline!important}.ndc-search-by{display:flex!important;gap:8px!important;align-items:center!important;border-top:1px solid #ead6ad!important;margin-top:16px!important;padding-top:12px!important;font-size:12px!important}.ndc-search-by span{padding:6px 10px!important;border:1px solid #d9b878!important;border-radius:999px!important;color:#a8732c!important;background:#fff!important}.ndc-price-box{display:flex!important;align-items:center!important;gap:7px!important;color:#fff!important}.ndc-price-field{display:grid!important;gap:2px!important}.ndc-price-field label{font-size:10px!important;font-weight:800!important;letter-spacing:.08em!important;opacity:.75!important}.ndc-price-field input{width:88px!important;height:36px!important;padding:0 10px!important;border:1px solid rgba(217,184,120,.55)!important;border-radius:8px!important;background:#171717!important;color:#fff!important;outline:0!important}.ndc-reset{color:#d9b878!important;background:transparent!important;border:0!important;text-decoration:underline!important;cursor:pointer!important;font-weight:800!important;font-size:12px!important}.ndc-trust{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:10px!important;margin:16px 0 22px!important;padding:12px!important;background:#fffaf2!important;border:1px solid #ead6ad!important;border-radius:18px!important}.ndc-trust span{display:block!important;padding:10px!important;background:#ffffffcc!important;border-radius:12px!important;text-align:center!important;color:#1f1812!important;font-size:13px!important;font-weight:700!important}.ndc-grid{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:22px!important;width:100%!important;padding:18px!important;background:#fff!important;border:1px solid #efe1c2!important;border-radius:18px!important;min-height:300px!important}.ndc-card{display:block!important;background:#fff!important;border:1px solid #ead6ad!important;border-radius:18px!important;overflow:hidden!important;box-shadow:0 14px 34px rgba(73,43,12,.09)!important}.ndc-card.is-hidden{display:none!important}.ndc-media{display:block!important;aspect-ratio:3/4!important;width:100%!important;background:#fff8ee!important;overflow:hidden!important;text-decoration:none!important}.ndc-media img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important}.ndc-body{padding:14px!important;background:#fff!important;color:#1f1812!important;min-height:112px!important}.ndc-title{display:block!important;color:#1f1812!important;text-decoration:none!important;font-size:14px!important;font-weight:800!important;line-height:1.3!important;min-height:38px!important}.ndc-price{display:block!important;margin-top:8px!important;color:#8c641f!important;font-weight:900!important}.ndc-cta{display:inline-flex!important;margin-top:10px!important;padding:8px 12px!important;border-radius:999px!important;background:#111!important;color:#fff!important;text-decoration:none!important;font-size:12px!important;font-weight:800!important}.ndc-pages{display:flex!important;flex-wrap:wrap!important;justify-content:center!important;gap:8px!important;margin:24px 0 0!important}.ndc-pages a,.ndc-pages span{display:inline-flex!important;padding:8px 12px!important;border:1px solid #ead6ad!important;border-radius:999px!important;color:#1f1812!important;text-decoration:none!important;background:#fff!important}@media(max-width:989px){#nil-direct-collection-mount{padding-left:12px!important;padding-right:12px!important}.ndc-toolbar{grid-template-columns:1fr!important}.ndc-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;padding:10px!important;gap:14px!important}.ndc-trust{grid-template-columns:1fr!important}.ndc-mini-grid{grid-template-columns:1fr!important}}
    </style>
    {% liquid assign ndc_sort = collection.sort_by | default: collection.default_sort_by | default: 'manual' assign ndc_count = collection.products_count | default: 0 %}
    <header class="ndc-head"><span class="ndc-eyebrow">Luxury Bridal Collection</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}<div class="ndc-count">{{ ndc_count }} Products</div></header>
    <nav class="ndc-toolbar" aria-label="Collection controls">
      <div class="ndc-left"><span class="ndc-label">SORT BY:</span>{% assign ndc_opts='manual|Featured,best-selling|Best Seller,title-ascending|A–Z,title-descending|Z–A,price-ascending|Price ↑,price-descending|Price ↓,created-ascending|Oldest,created-descending|Newest'|split:',' %}{% for ndc_o in ndc_opts %}{% assign ndc_p=ndc_o|split:'|' %}<a class="ndc-pill{% if ndc_sort == ndc_p[0] %} is-active{% endif %}" href="{{ collection.url }}?sort_by={{ ndc_p[0] }}">{{ ndc_p[1] }}</a>{% endfor %}</div>
      <div class="ndc-search-wrap"><div class="ndc-search"><span>⌕</span><input id="ndc-search-input" type="search" autocomplete="off" placeholder="Search all dresses, tags, details..."><small>Search all products</small><button class="ndc-x" type="button">×</button></div><div id="ndc-results" class="ndc-results"><div class="ndc-results-head"><span>Searching all products across the entire store</span><a id="ndc-view-all" class="ndc-view-all" href="/search?type=product&q=">View all results →</a></div><div id="ndc-result-count" style="font-size:13px;margin-bottom:12px">Type to search products.</div><div id="ndc-mini-grid" class="ndc-mini-grid"></div><div class="ndc-search-by"><b>Search by:</b><span>Title</span><span>Tags</span><span>Product details</span></div></div></div>
      <div class="ndc-price-box"><div class="ndc-price-field"><label>MIN PRICE</label><input id="ndc-min-price" type="number" min="0" placeholder="$ 0"></div><div class="ndc-price-field"><label>MAX PRICE</label><input id="ndc-max-price" type="number" min="0" placeholder="$ 5000+"></div><button id="ndc-reset" class="ndc-reset" type="button">Reset</button></div>
      <div class="ndc-cols"><span class="ndc-label">COLUMNS:</span><span class="ndc-pill">2</span><span class="ndc-pill">3</span><span class="ndc-pill is-active">4</span><span class="ndc-pill">5</span></div>
    </nav>
    <div class="ndc-trust"><span>Private appointment only</span><span>Worldwide insured shipping</span><span>Custom size support</span><span>WhatsApp consultation</span></div>
    {% paginate collection.products by 48 %}{% if collection.products.size > 0 %}<div class="ndc-grid" id="ndc-grid">{% for product in collection.products %}<article class="ndc-card" data-price="{{ product.price | divided_by: 100.0 }}"><a class="ndc-media" href="{{ product.url }}">{% if product.featured_media.preview_image %}{{ product.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw', alt: product.title }}{% else %}<div>{{ product.title }}</div>{% endif %}</a><div class="ndc-body"><a class="ndc-title" href="{{ product.url }}">{{ product.title }}</a><span class="ndc-price">{{ product.price | money_without_trailing_zeros }}</span><a class="ndc-cta" href="{{ product.url }}">View Dress</a></div></article>{% endfor %}</div>{% else %}<div class="ndc-head"><h2>No products found</h2><p>Please add products to this collection.</p></div>{% endif %}{% if paginate.pages > 1 %}<div class="ndc-pages">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">‹ Previous</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}">Next ›</a>{% endif %}</div>{% endif %}{% endpaginate %}
    <script src="{{ 'nil-collection-direct-search.js' | asset_url }}" defer></script>
  </div>
{% endif %}

{% comment %} NIL SCORE MAX START - GDPR/cookie notice {% endcomment %}
<div class="nil-cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie notice" hidden>
  <div><strong>Privacy & cookies</strong><span>We use essential cookies to improve your bridal shopping experience, cart, language and analytics.</span></div>
  <a href="/policies/privacy-policy">Privacy Policy</a>
  <button type="button" data-nil-cookie-accept>Accept</button>
</div>
{% comment %} NIL SCORE MAX END {% endcomment %}
