<style id="a-g21-filtre-temizleme-css">
.a-g21-filtre-panel{display:none!important}.a-g21-filtre-form[data-a-g21-mobile-open='true'] .a-g21-filtre-panel,.a-g21-filtre-panel.is-open{display:grid!important}.a-g21-filter-hidden{display:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important}.a-g21-global-dil-cubugu,.a-g21-global-dil-cubugu .a-g21-dil-secici{display:block!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important}.a-g21-global-dil-cubugu .a-g21-dil-secici__liste{display:flex!important}.nil-top-language-banner,.dropdown-localization,dropdown-localization-component,.nil-language-suggestion-popup,#nil-language-suggestion-popup,.nil-floating-language,.nil-language-menu,.nil-top-language-slot{display:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important}.a-g21-filtre-form__ust{border-radius:18px!important;background:rgba(255,255,255,.68)!important;box-shadow:0 10px 24px rgba(143,100,28,.08)!important}.a-g21-filtre-grup{min-height:auto!important}.a-g21-filtre-secenekler:empty{display:none!important}
</style>
<script id="a-g21-filtre-temizleme-js">
(function(){if(window.A_G21_FILTER_CLEAN_READY)return;window.A_G21_FILTER_CLEAN_READY=true;function all(s,c){return Array.prototype.slice.call((c||document).querySelectorAll(s));}function hide(e){e.classList.add('a-g21-filter-hidden');e.hidden=true;e.style.display='none';e.style.visibility='hidden';}function show(e){e.classList.remove('a-g21-filter-hidden');e.hidden=false;e.style.display='';e.style.visibility='';e.style.opacity='';}function clean(){all('.a-g21-global-dil-cubugu,.a-g21-global-dil-cubugu .a-g21-dil-secici').forEach(show);all('.nil-top-language-banner,.dropdown-localization,dropdown-localization-component,.nil-language-suggestion-popup,#nil-language-suggestion-popup,.nil-floating-language,.nil-language-menu,.nil-top-language-slot').forEach(hide);all('.a-g21-filtre-grup').forEach(function(g){var sum=g.querySelector('summary');var txt=((sum?sum.textContent:g.textContent)||'').toLowerCase();if(txt.indexOf('daha fazla')>-1||txt.indexOf('tag')>-1||txt.indexOf('stok')>-1||txt.indexOf('availability')>-1){hide(g);return;}all('.a-g21-filtre-value',g).forEach(function(v){var t=(v.textContent||'').toLowerCase();if(t.indexOf('g21-')>-1||t.indexOf('nil-')>-1){hide(v);}});});}function bind(){all('[data-a-g21-filter-toggle="true"]').forEach(function(b){if(b.__g21FilterClean)return;b.__g21FilterClean=true;b.addEventListener('click',function(){var f=b.closest('[data-a-g21-filter-form="true"]');var p=f&&f.querySelector('[data-a-g21-filter-panel="true"]');if(!f||!p)return;var open=f.getAttribute('data-a-g21-mobile-open')==='true';f.setAttribute('data-a-g21-mobile-open',open?'false':'true');p.classList.toggle('is-open',!open);b.setAttribute('aria-expanded',(!open).toString());});});clean();}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',bind,{once:true});}else{bind();}window.addEventListener('load',bind);document.addEventListener('shopify:section:load',bind);})();
</script>