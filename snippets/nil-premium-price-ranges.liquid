<div class="nil-price-panel" data-nil-price-panel hidden>
  <div class="nil-price-panel__inner" role="dialog" aria-modal="false" aria-label="Price filter ranges">
    <button type="button" class="nil-price-panel__close" data-nil-price-close aria-label="Close price filter">{% render 'nil-local-svg-icon', icon: 'close', size: 24 %}</button>
    <h3>PRICE (USD)</h3>
    <div class="nil-price-panel__ranges">
      <button type="button" data-nil-price-range data-min="800" data-max="1000">$800 – $1000</button>
      <button type="button" data-nil-price-range data-min="1000" data-max="1250">$1000 – $1250</button>
      <button type="button" data-nil-price-range data-min="1250" data-max="1500">$1250 – $1500</button>
      <button type="button" data-nil-price-range data-min="1500" data-max="2000">$1500 – $2000</button>
      <button type="button" data-nil-price-range data-min="2000" data-max="2500">$2000 – $2500</button>
      <button type="button" data-nil-price-range data-min="2500" data-max="3000">$2500 – $3000</button>
    </div>
    <p><span>✦</span> Results update automatically as you refine your filters.</p>
  </div>
</div>
